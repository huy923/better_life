<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:text="Lịch sử nhịp tim"
            android:textSize="20sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- Source filter -->
        <Spinner android:id="@+id/spSourceFilter"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginBottom="12dp"/>

        <!-- Period toggle -->
        <RadioGroup android:id="@+id/rgPeriod"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp">
            <RadioButton android:id="@+id/rbWeek"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="7 ngày" android:checked="true"/>
            <RadioButton android:id="@+id/rbMonth"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="30 ngày"/>
        </RadioGroup>

        <!-- 7-day bar chart -->
        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/weeklyBarChart"
            android:layout_width="match_parent" android:layout_height="200dp"
            android:layout_marginBottom="12dp"/>

        <!-- 30-day line chart -->
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/monthlyLineChart"
            android:layout_width="match_parent" android:layout_height="200dp"
            android:visibility="gone" android:layout_marginBottom="12dp"/>

        <TextView android:id="@+id/tvNoData"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Chưa có dữ liệu" android:gravity="center"
            android:textColor="#888888" android:visibility="gone"
            android:layout_marginBottom="12dp"/>

        <!-- Anomalies badge -->
        <TextView android:id="@+id/tvAnomalies"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Không có bất thường" android:textSize="13sp"
            android:gravity="center" android:padding="8dp"
            android:background="#22000000" android:layout_marginBottom="12dp"/>

        <!-- Session list -->
        <ListView android:id="@+id/lvSessions"
            android:layout_width="match_parent" android:layout_height="320dp"
            android:dividerHeight="1dp"/>

    </LinearLayout>
</ScrollView>
