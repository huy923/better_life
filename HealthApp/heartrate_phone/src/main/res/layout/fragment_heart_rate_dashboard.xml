<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Source selector -->
        <RadioGroup android:id="@+id/rgSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">
            <RadioButton android:id="@+id/rbPhone"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Điện thoại" android:checked="true" android:layout_marginEnd="24dp"/>
            <RadioButton android:id="@+id/rbWatch"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Đồng hồ"/>
        </RadioGroup>

        <TextView android:id="@+id/tvSource"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Điện thoại (Camera PPG)"
            android:textSize="12sp" android:textColor="#888888"
            android:gravity="center" android:layout_marginBottom="8dp"/>

        <!-- BPM ring + large number -->
        <FrameLayout android:layout_width="180dp" android:layout_height="180dp"
            android:layout_gravity="center_horizontal" android:layout_marginBottom="8dp">
            <ProgressBar android:id="@+id/progressRing"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:progress="72" android:max="200"
                android:progressDrawable="@drawable/circle_progress"
                android:visibility="invisible"/>
            <TextView android:id="@+id/tvCurrentBpm"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="--"
                android:textSize="64sp" android:textStyle="bold"
                android:textColor="#1D9E75"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center|bottom" android:layout_marginBottom="32dp"
                android:text="BPM" android:textSize="14sp" android:textColor="#888888"/>
        </FrameLayout>

        <!-- Status + trend -->
        <TextView android:id="@+id/tvStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Sẵn sàng" android:gravity="center"
            android:textSize="14sp" android:textColor="#888888"
            android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/tvTrend"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="→ Ổn định" android:gravity="center"
            android:textSize="13sp" android:textColor="#888888"
            android:layout_marginBottom="12dp"/>

        <!-- Stats row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:weightSum="3"
            android:layout_marginBottom="16dp">
            <TextView android:id="@+id/tvAvgBpm"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:text="Avg: --" android:textSize="13sp"/>
            <TextView android:id="@+id/tvMaxBpm"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:text="Max: --" android:textSize="13sp"/>
            <TextView android:id="@+id/tvMinBpm"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:text="Min: --" android:textSize="13sp"/>
        </LinearLayout>

        <!-- Real-time chart -->
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/heartRateChart"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="16dp"/>

        <!-- Controls -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:weightSum="2" android:gravity="center">
            <Button android:id="@+id/btnStartHr"
                android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:text="Bắt đầu đo"/>
            <Button android:id="@+id/btnStopHr"
                android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:layout_marginStart="8dp"
                android:text="Dừng &amp; Lưu" android:enabled="false"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
