<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Kết nối Health Connect" android:textSize="20sp" android:textStyle="bold"
        android:gravity="center" android:layout_marginBottom="12dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Ứng dụng cần quyền đọc/ghi dữ liệu nhịp tim từ Health Connect để đồng bộ với Samsung Health và Google Health."
        android:textSize="14sp" android:gravity="center" android:layout_marginBottom="24dp"/>
    <TextView android:id="@+id/tvHcStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Đang kiểm tra..." android:gravity="center"
        android:textSize="13sp" android:textColor="#888888" android:layout_marginBottom="16dp"/>
    <Button android:id="@+id/btnGrantHc"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:text="Cấp quyền Health Connect"/>
</LinearLayout>
