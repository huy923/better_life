<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.health.heartrate.wear">

    <uses-permission android:name="android.permission.BODY_SENSORS"/>
    <uses-permission android:name="android.permission.BODY_SENSORS_BACKGROUND"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-feature android:name="android.hardware.sensor.heartrate" android:required="true"/>

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.AppCompat">

        <!-- Main Activity -->
        <activity android:name=".ui.ambient.WearHeartRateActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Foreground HR service -->
        <service android:name=".service.WearHeartRateService"
            android:foregroundServiceType="health"
            android:exported="false"/>

        <!-- Command listener from phone -->
        <service android:name=".sync.WearCommandListenerService"
            android:exported="true"
            android:permission="com.google.android.gms.permission.BIND_LISTENER">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED"/>
                <data android:scheme="wear" android:host="*" android:pathPrefix="/command"/>
            </intent-filter>
        </service>

        <!-- Wear Tile -->
        <service android:name=".ui.tile.HeartRateTileService"
            android:exported="true"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER"/>
            </intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" android:value="true"/>
        </service>

        <!-- Watch face complication -->
        <service android:name=".ui.complication.HeartRateComplicationService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_compass"
            android:label="Nhịp tim"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT,LONG_TEXT"/>
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="30"/>
        </service>

    </application>
</manifest>
