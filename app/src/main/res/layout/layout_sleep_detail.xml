<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circle_white_alpha"
                    android:padding="8dp"
                    android:src="@drawable/ic_back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/sleep"
                    android:textColor="@color/text_title"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Summary Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/iv_sleep_icon_box"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/progress_sleep"
                            android:backgroundTint="@color/icon_sleep"
                            android:padding="14dp"
                            android:src="@drawable/ic_crescent_moon"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/white" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="@id/iv_sleep_icon_box"
                            app:layout_constraintStart_toEndOf="@id/iv_sleep_icon_box"
                            app:layout_constraintTop_toTopOf="@id/iv_sleep_icon_box">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/last_night"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_sleep_duration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="7h 30p"
                                android:textColor="@color/icon_sleep"
                                android:textSize="32sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_purple_boder"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_energy"
                                app:tint="@color/icon_sleep" />

                            <TextView
                                android:id="@+id/tv_sleep_score"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                tools:text="85"
                                android:textColor="@color/icon_sleep"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Stats Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chat_input_field"
                            android:backgroundTint="#F5F5F5"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:src="@drawable/ic_sleep_start" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/sleep_start" android:textSize="10sp" android:textColor="@color/text_secondary" />
                            <TextView android:id="@+id/tv_sleep_start" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="23:00" android:textStyle="bold" android:textColor="@color/text_title" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chat_input_field"
                            android:backgroundTint="#F5F5F5"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:src="@drawable/ic_wake_up" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/wake_up" android:textSize="10sp" android:textColor="@color/text_secondary" />
                            <TextView android:id="@+id/tv_sleep_end" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="06:30" android:textStyle="bold" android:textColor="@color/text_title" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chat_input_field"
                            android:backgroundTint="#F5F5F5"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:src="@drawable/ic_watch" app:tint="@color/deep_sleep_color" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/deep_sleep" android:textSize="10sp" android:textColor="@color/text_secondary" />
                            <TextView android:id="@+id/tv_deep_sleep_duration_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="2h 45p" android:textStyle="bold" android:textColor="@color/text_title" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Sleep Stages Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sleep_stages"
                        android:textColor="@color/text_title"
                        android:textStyle="bold" />

                    <!-- Hypnogram Placeholder -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_chat_ai"
                        android:backgroundTint="#F8FAFB" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="23:00" android:textSize="10sp" android:textColor="@color/text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="01:00" android:gravity="center" android:textSize="10sp" android:textColor="@color/text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="03:00" android:gravity="center" android:textSize="10sp" android:textColor="@color/text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="05:00" android:gravity="end" android:textSize="10sp" android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <!-- Legend & Progress -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="vertical">

                        <!-- Awake -->
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
                            <View android:id="@+id/dot_awake" android:layout_width="12dp" android:layout_height="12dp" android:layout_centerVertical="true" android:background="@drawable/circle_white_alpha" android:backgroundTint="@color/awake_color" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_toEndOf="@id/dot_awake" android:text="@string/awake" android:textColor="@color/text_secondary" android:textSize="14sp" />
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:gravity="center_vertical">
                                <TextView android:id="@+id/tv_awake_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="30 phút" android:textColor="@color/text_title" android:textStyle="bold" android:textSize="14sp" />
                                <View android:layout_width="40dp" android:layout_height="6dp" android:layout_marginStart="8dp" android:background="@drawable/mini_progress_bar" android:backgroundTint="@color/awake_color" />
                            </LinearLayout>
                        </RelativeLayout>

                        <!-- Light Sleep -->
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
                            <View android:id="@+id/dot_light" android:layout_width="12dp" android:layout_height="12dp" android:layout_centerVertical="true" android:background="@drawable/circle_white_alpha" android:backgroundTint="@color/light_sleep_color" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_toEndOf="@id/dot_light" android:text="@string/light_sleep" android:textColor="@color/text_secondary" android:textSize="14sp" />
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:gravity="center_vertical">
                                <TextView android:id="@+id/tv_light_sleep_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="2h 15p" android:textColor="@color/text_title" android:textStyle="bold" android:textSize="14sp" />
                                <View android:layout_width="60dp" android:layout_height="6dp" android:layout_marginStart="8dp" android:background="@drawable/mini_progress_bar" android:backgroundTint="@color/light_sleep_color" />
                            </LinearLayout>
                        </RelativeLayout>

                        <!-- Deep Sleep -->
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
                            <View android:id="@+id/dot_deep" android:layout_width="12dp" android:layout_height="12dp" android:layout_centerVertical="true" android:background="@drawable/circle_white_alpha" android:backgroundTint="@color/deep_sleep_color" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_toEndOf="@id/dot_deep" android:text="@string/deep_sleep" android:textColor="@color/text_secondary" android:textSize="14sp" />
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:gravity="center_vertical">
                                <TextView android:id="@+id/tv_deep_sleep_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="2h 45p" android:textColor="@color/text_title" android:textStyle="bold" android:textSize="14sp" />
                                <View android:layout_width="80dp" android:layout_height="6dp" android:layout_marginStart="8dp" android:background="@drawable/mini_progress_bar" android:backgroundTint="@color/deep_sleep_color" />
                            </LinearLayout>
                        </RelativeLayout>

                        <!-- REM -->
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                            <View android:id="@+id/dot_rem" android:layout_width="12dp" android:layout_height="12dp" android:layout_centerVertical="true" android:background="@drawable/circle_white_alpha" android:backgroundTint="@color/rem_sleep_color" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_toEndOf="@id/dot_rem" android:text="@string/rem" android:textColor="@color/text_secondary" android:textSize="14sp" />
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:gravity="center_vertical">
                                <TextView android:id="@+id/tv_rem_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="2h" android:textColor="@color/text_title" android:textStyle="bold" android:textSize="14sp" />
                                <View android:layout_width="50dp" android:layout_height="6dp" android:layout_marginStart="8dp" android:background="@drawable/mini_progress_bar" android:backgroundTint="@color/rem_sleep_color" />
                            </LinearLayout>
                        </RelativeLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Weekly Chart -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sleep_this_week"
                            android:textColor="@color/text_title"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_weekly_avg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            tools:text="📈 TB: 7.4h"
                            android:textColor="@color/trend_up"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="24dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">
                        <View android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginHorizontal="6dp" android:background="@drawable/mini_progress_bar" android:backgroundTint="@color/icon_sleep" />
                        <View android:layout_width="0dp" android:layout_height="65dp" android:layout_weight="1" android:layout_marginHorizontal="6dp" android:background="@drawable/mini_progress_bar" android:backgroundTint="@color/icon_sleep" />
                        <View android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginHorizontal="6dp" android:background="@drawable/mini_progress_bar" android:backgroundTint="@color/icon_sleep" />
                        <View android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginHorizontal="6dp" android:background="@drawable/mini_progress_bar" android:backgroundTint="@color/icon_sleep" />
                        <View android:layout_width="0dp" android:layout_height="45dp" android:layout_weight="1" android:layout_marginHorizontal="6dp" android:background="@drawable/mini_progress_bar" android:backgroundTint="@color/icon_sleep" />
                        <View android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginHorizontal="6dp" android:background="@drawable/mini_progress_bar" android:backgroundTint="@color/icon_sleep" />
                        <View android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginHorizontal="6dp" android:background="@drawable/mini_progress_bar" android:backgroundTint="@color/icon_sleep" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>