<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/chat_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="15dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_robot" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ AI Coach"
                android:textColor="@color/text_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Luôn sẵn sàng hỗ trợ bạn"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Chat Messages -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@+id/chat_quick_replies"
        app:layout_constraintTop_toBottomOf="@id/chat_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- AI Message 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="60dp"
                android:background="@drawable/bg_chat_ai"
                android:elevation="1dp"
                android:padding="16dp"
                android:text="Chào bạn! Tôi là AI Coach của bạn 🤖 Tôi thấy bạn đã đi được 7,200 bước hôm nay, chỉ còn 2,800 bước nữa thôi! Bạn có muốn tôi gợi ý cách hoàn thành mục tiêu không?"
                android:textColor="@color/text_body"
                android:textSize="14sp" />

            <!-- User Message -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginStart="60dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_chat_user"
                android:elevation="1dp"
                android:padding="16dp"
                android:text="Mình đang mất động lực lắm, mệt quá không muốn tập nữa 😫"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <!-- AI Message 2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="40dp"
                android:background="@drawable/bg_chat_ai"
                android:elevation="1dp"
                android:padding="16dp"
                android:text="Tôi hiểu cảm giác đó! Nhưng hãy nhìn lại nhé - bạn đã duy trì tập luyện được 15 ngày liên tục rồi! 🔥 Đó là một thành tích tuyệt vời!\n\nHãy thử cách này: Đi bộ nhẹ 10 phút thôi. Không cần chạy, chỉ cần bước đi. Thường thì khi bắt đầu, bạn sẽ muốn tiếp tục! 💪\n\nNhớ rằng: Mỗi bước đi hôm nay là một phần thưởng cho sức khỏe ngày mai! 🌟"
                android:textColor="@color/text_body"
                android:textSize="14sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Quick Replies -->
    <HorizontalScrollView
        android:id="@+id/chat_quick_replies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:padding="8dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/chat_input_area">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circle_white_alpha"
                android:backgroundTint="#F0F4F8"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="Tư vấn bữa ăn hôm nay"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circle_white_alpha"
                android:backgroundTint="#F0F4F8"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="Lịch tập phù hợp cho tôi"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/circle_white_alpha"
                android:backgroundTint="#F0F4F8"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="Tôi muốn thêm..."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Input Area (Optimized) -->
    <LinearLayout
        android:id="@+id/chat_input_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_microphone"
                app:tint="@color/text_secondary" />

            <EditText
                android:id="@+id/et_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Hỏi AI Coach..."
                android:minHeight="40dp"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_icon_bg"
                android:backgroundTint="@color/primary_teal"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_send"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>