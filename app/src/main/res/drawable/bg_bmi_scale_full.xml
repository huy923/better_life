<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <size android:height="16dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <!-- Blue: Underweight -->
    <item android:right="250dp">
        <shape android:shape="rectangle">
            <corners android:bottomLeftRadius="10dp" android:topLeftRadius="10dp" />
            <solid android:color="#4FC3F7" />
        </shape>
    </item>
    <!-- Green: Normal -->
    <item android:left="80dp" android:right="130dp">
        <shape android:shape="rectangle">
            <solid android:color="#2DD1AC" />
        </shape>
    </item>
    <!-- Orange: Overweight -->
    <item android:left="200dp" android:right="50dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFB74D" />
        </shape>
    </item>
    <!-- Red: Obese -->
    <item android:left="280dp">
        <shape android:shape="rectangle">
            <corners android:bottomRightRadius="10dp" android:topRightRadius="10dp" />
            <solid android:color="#EF5350" />
        </shape>
    </item>
</layer-list>