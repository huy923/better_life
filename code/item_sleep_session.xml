<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Quality Indicator Bar -->
        <View
            android:id="@+id/qualityIndicator"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="#4CAF50"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header: Date and Duration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="01/01/2024 22:30"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"/>

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8 giờ 15 phút"
                    android:textSize="14sp"
                    android:textColor="#1976D2"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- Quality Score -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chất lượng: "
                    android:textSize="14sp"
                    android:textColor="#666666"/>

                <TextView
                    android:id="@+id/tvQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="85.0/100"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvQualityRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(Rất tốt)"
                    android:textSize="14sp"
                    android:textColor="#4CAF50"/>

            </LinearLayout>

            <!-- Sleep Stages Breakdown -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F5F5F5"
                android:padding="8dp"
                android:gravity="center">

                <!-- Deep Sleep -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#1976D2"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ngủ Sâu"
                        android:textSize="11sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:id="@+id/tvDeepSleep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2h 15m"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>

                </LinearLayout>

                <!-- Light Sleep -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#64B5F6"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ngủ Nhẹ"
                        android:textSize="11sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:id="@+id/tvLightSleep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4h 30m"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>

                </LinearLayout>

                <!-- REM Sleep -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#FFB74D"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REM"
                        android:textSize="11sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:id="@+id/tvRemSleep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1h 30m"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
